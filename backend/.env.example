# ===== Server =====
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ===== Database (PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=festival_of_independence
DB_USER=postgres
DB_PASSWORD=your_db_password

# ===== JWT =====
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ===== Razorpay =====
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
REGISTRATION_FEE_INR=500

# ===== Email (SMTP) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM="Festival of Independence - IYF Kolkata" <no-reply@iyfkolkata.org>

# ===== Admin Bootstrap (used only by the seed script) =====
SEED_ADMIN_NAME=IYF Kolkata Admin
SEED_ADMIN_EMAIL=nitin.231218@gmail.com
SEED_ADMIN_PASSWORD=change_this_password
